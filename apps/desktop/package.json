{
  "name": "@loom/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Loom Tracker window, connected to the coordinator.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "perf": "node perf/harness.mjs",
    "test:terminal": "node perf/terminal-resize.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "postinstall": "node scripts/fix-spawn-helper.mjs && node scripts/name-dev-app.mjs",
    "test:workbench": "tsx scripts/workbench-smoke.ts"
  },
  "dependencies": {
    "@loom/core": "workspace:*",
    "@loom/protocol": "workspace:*",
    "@pierre/diffs": "1.4.2",
    "@tanstack/react-virtual": "^3.14.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "dockview": "4.13.1",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
