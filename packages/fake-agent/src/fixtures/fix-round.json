[
  {
    "name": "initial implementer",
    "agent": {
      "provider": "codex",
      "role": "implementer",
      "mode": "headless"
    },
    "steps": [
      {
        "expect": "message"
      },
      {
        "status": "working"
      },
      {
        "git": "commit",
        "files": {
          "example.txt": "first implementation"
        },
        "message": "first implementation"
      },
      {
        "tool": "submit_for_review",
        "input": {
          "headSha": "$HEAD",
          "summary": "Ready",
          "testResults": [],
          "handoff": {
            "summary": "Ready",
            "nextSteps": []
          }
        }
      },
      {
        "status": "idle"
      }
    ]
  },
  {
    "name": "fresh implementer fix round",
    "agent": {
      "provider": "codex",
      "role": "implementer",
      "mode": "headless"
    },
    "steps": [
      {
        "expect": "message",
        "match": "fresh implementer fix-round session"
      },
      {
        "git": "commit",
        "files": {
          "example.txt": "fixed implementation"
        },
        "message": "fixed implementation"
      },
      {
        "tool": "resolve_finding",
        "input": {
          "findingId": "$FINDING_0",
          "resolution": "fixed",
          "note": "Fixed",
          "commitSha": "$HEAD"
        }
      },
      {
        "tool": "submit_for_review",
        "input": {
          "headSha": "$HEAD",
          "summary": "Ready",
          "testResults": [],
          "handoff": {
            "summary": "Ready",
            "nextSteps": []
          }
        }
      },
      {
        "status": "idle"
      }
    ]
  },
  {
    "name": "first review",
    "agent": {
      "provider": "claude",
      "role": "reviewer",
      "mode": "headless"
    },
    "steps": [
      {
        "expect": "message"
      },
      {
        "tool": "submit_review",
        "input": {
          "reviewedSha": "$HEAD",
          "summary": "Reviewed",
          "findings": [
            {
              "severity": "major",
              "title": "Fix bug",
              "body": "Wrong value",
              "location": null,
              "status": "escalate",
              "reason": "The fix requires a design change beyond safe inline review."
            }
          ],
          "verdicts": [],
          "testResults": [],
          "reviewerCommits": []
        }
      }
    ]
  },
  {
    "name": "verify fix",
    "agent": {
      "provider": "claude",
      "role": "reviewer",
      "mode": "headless"
    },
    "steps": [
      {
        "expect": "message"
      },
      {
        "tool": "submit_review",
        "input": {
          "reviewedSha": "$HEAD",
          "summary": "Reviewed",
          "findings": [],
          "verdicts": [
            {
              "findingId": "$FINDING_0",
              "status": "resolved",
              "note": "Verified"
            }
          ],
          "testResults": [],
          "reviewerCommits": []
        }
      }
    ]
  }
]
