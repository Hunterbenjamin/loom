[
  {
    "name": "implementation before inline review",
    "agent": {
      "provider": "codex",
      "role": "implementer",
      "mode": "headless"
    },
    "steps": [
      {
        "expect": "message"
      },
      {
        "status": "working"
      },
      {
        "git": "commit",
        "files": {
          "example.txt": "first implementation"
        },
        "message": "first implementation"
      },
      {
        "tool": "submit_for_review",
        "input": {
          "headSha": "$HEAD",
          "summary": "Ready",
          "testResults": [],
          "handoff": {
            "summary": "Ready",
            "nextSteps": []
          }
        }
      },
      {
        "status": "idle"
      }
    ]
  },
  {
    "name": "reviewer checks and reports a note",
    "agent": {
      "provider": "claude",
      "role": "reviewer",
      "mode": "headless"
    },
    "steps": [
      {
        "expect": "message"
      },
      {
        "tool": "submit_review",
        "input": {
          "reviewedSha": "$HEAD",
          "reviewerCommits": [],
          "summary": "Matches the plan; one optional note",
          "findings": [
            {
              "severity": "minor",
              "title": "Name the value",
              "body": "A named constant would read better; optional.",
              "status": "open",
              "location": null
            }
          ],
          "verdicts": [],
          "testResults": []
        }
      }
    ]
  }
]
